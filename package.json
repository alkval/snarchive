{
  "name": "snarchive",
  "version": "0.2.8",
  "private": true,
  "license": "MIT",
  "author": "Alexander Kvalvaag",
  "main": "index.ts",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --dev-client",
    "android": "EXPO_NO_TELEMETRY=1 expo run:android",
    "ios": "EXPO_NO_TELEMETRY=1 expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:native-prototype": "node scripts/test-native-prototype.mjs",
    "test:apple-prototype": "node scripts/test-apple-prototype.mjs",
    "fixtures:inventory": "node scripts/generate-inventory-fixture.mjs",
    "test:zip-engine": "node scripts/test-zip-engine.mjs",
    "prepare:preview": "node scripts/prepare-local-preview.mjs",
    "prepare:android-preview": "node --experimental-strip-types scripts/prepare-android-preview.ts",
    "package:android-preview": "node --experimental-strip-types scripts/package-android-preview.ts",
    "init:android-personal-key": "node --experimental-strip-types scripts/init-android-personal-key.ts",
    "package:android-personal": "node --experimental-strip-types scripts/package-android-personal.ts",
    "test:original-store": "node scripts/test-original-store.mjs",
    "fixtures:resume": "python3 scripts/generate-resume-fixture.py",
    "fixtures:video": "python3 scripts/generate-video-fixture.py",
    "test:backup-writer": "node scripts/test-backup-writer.mjs",
    "test:backup-inspection": "node scripts/test-backup-inspection.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.13",
    "expo-dev-client": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.11",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
